diff --git a/ggml/include/ggml-pocket.h b/ggml/include/ggml-pocket.h
new file mode 100644
index 0000000..32ac0d4
--- /dev/null
+++ b/ggml/include/ggml-pocket.h
@@ -0,0 +1,44 @@
+// PocketLLM expert streaming for memory-mapped MoE models on the CPU.
+//
+// When a MoE model is larger than RAM, llama.cpp memory-maps it and the OS
+// faults weights in from storage page by page, synchronously, on the compute
+// threads. That leaves fast storage (NVMe, USB4 SSDs, several drives) mostly
+// idle. This module turns those faults into early, large, concurrent reads:
+//
+//  1. expert prefetch   - as soon as the router has picked the experts of a layer,
+//                         issue async read-ahead for their gate/up/down slices
+//  2. next-layer predict - learn which experts of layer L+1 follow those of layer L
+//                         (online transition counts) and read them ahead
+//  3. hot-expert pinning - keep the most frequently routed experts resident (mlock)
+//  4. multi-file aware   - each mapped file has its own descriptor, so a model whose
+//                         split files live on different drives is read in parallel
+//
+// Enabled with POCKET_MOE=1. Other knobs (environment):
+//   POCKET_MOE_PREDICT=0|1   next-layer prediction (default 0: costs bandwidth when I/O-bound)
+//   POCKET_MOE_PIN_MIB=N     pin up to N MiB of hot experts (default 0 = off)
+//   POCKET_MOE_STATS=path    write routing statistics at exit (and read them at start)
+//   POCKET_MOE_VERBOSE=1     print a summary at exit
+//   POCKET_MOE_IO_THREADS=N  read ahead with N pread() worker threads instead of
+//                            fadvise/F_RDADVISE hints (portable fallback; default 0)
+//   POCKET_MOE_NORA=1        disable fault read-around on routed-expert tensors only (MADV_RANDOM)
+//   POCKET_MOE_NORA=2        disable it on the whole mapping (diagnostic; works without POCKET_MOE)
+#pragma once
+
+#include "ggml.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// register a read-only file mapping: [addr, addr+size) maps file `fd` from offset 0
+GGML_API void ggml_pocket_register_mapping(const void * addr, size_t size, int fd);
+
+// called by the CPU backend for every MUL_MAT_ID once the expert ids are known
+// counts[e] = number of rows routed to expert e (n_expert entries); n_tokens = ids->ne[1]
+GGML_API void ggml_pocket_moe_hook(const struct ggml_tensor * w, const int64_t * counts, int64_t n_expert, int64_t n_tokens);
+
+GGML_API bool ggml_pocket_enabled(void);
+
+#ifdef __cplusplus
+}
+#endif
