diff --git a/ggml/src/ggml-pocket.c b/ggml/src/ggml-pocket.c
new file mode 100644
index 0000000..94c07f4
--- /dev/null
+++ b/ggml/src/ggml-pocket.c
@@ -0,0 +1,1035 @@
+// PocketLLM expert streaming - see ggml/include/ggml-pocket.h for the design.
+#define _GNU_SOURCE
+#include "ggml-pocket.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// ---- portability layer -------------------------------------------------------------
+// POSIX (Linux, macOS): read-ahead through the file descriptor (posix_fadvise / F_RDADVISE)
+// or pread() worker threads; mlock for pinning; madvise(MADV_RANDOM) to stop read-around.
+// Windows: PrefetchVirtualMemory on the mapped address range (Windows 8+, looked up at run
+// time like llama.cpp does); VirtualLock for pinning; no read-around control.
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+typedef SRWLOCK pk_mutex;
+#define PK_MUTEX_INIT SRWLOCK_INIT
+static void pk_lock(pk_mutex * m)   { AcquireSRWLockExclusive(m); }
+static void pk_unlock(pk_mutex * m) { ReleaseSRWLockExclusive(m); }
+typedef struct { void * addr; SIZE_T size; } pk_range;   // = WIN32_MEMORY_RANGE_ENTRY
+typedef BOOL (WINAPI * pk_prefetch_fn)(HANDLE, ULONG_PTR, pk_range *, ULONG);
+static size_t pk_page_size(void) {
+    SYSTEM_INFO si;
+    GetSystemInfo(&si);
+    return si.dwPageSize;
+}
+#else
+#include <fcntl.h>
+#include <pthread.h>
+#include <sys/mman.h>
+#include <unistd.h>
+typedef pthread_mutex_t pk_mutex;
+#define PK_MUTEX_INIT PTHREAD_MUTEX_INITIALIZER
+static void pk_lock(pk_mutex * m)   { pthread_mutex_lock(m); }
+static void pk_unlock(pk_mutex * m) { pthread_mutex_unlock(m); }
+static size_t pk_page_size(void) { return (size_t) sysconf(_SC_PAGESIZE); }
+#endif
+
+// page-align [p, p + n) outward
+static void * pk_align(const void * p, size_t n, size_t * len) {
+    size_t ps = pk_page_size();
+    uintptr_t b = (uintptr_t) p & ~(uintptr_t) (ps - 1);
+    *len = n + ((uintptr_t) p - b);
+    return (void *) b;
+}
+
+// stop fault read-around on a range (POSIX only; Windows has no equivalent)
+static void pk_no_readaround(const void * p, size_t n) {
+#if defined(_WIN32)
+    (void) p; (void) n;
+#else
+    size_t len;
+    void * b = pk_align(p, n, &len);
+    madvise(b, len, MADV_RANDOM);
+#endif
+}
+
+static int pk_lock_pages(const void * p, size_t n, int on) {
+    size_t len;
+    void * b = pk_align(p, n, &len);
+#if defined(_WIN32)
+    return on ? (VirtualLock(b, len) ? 0 : -1) : (VirtualUnlock(b, len) ? 0 : -1);
+#else
+    return on ? mlock(b, len) : munlock(b, len);
+#endif
+}
+
+#define PK_MAX_MAPS   64
+#define PK_MAX_LAYERS 512
+#define PK_MAX_USED   64
+#define PK_KINDS      4   // gate, up, down, gate_up
+#define PK_PIN_EVERY  32  // re-evaluate the pinned set every N decode tokens
+
+struct pk_map { const char * base; size_t size; int fd; };
+
+struct pk_layer {
+    const char * data[PK_KINDS];
+    size_t       nb2[PK_KINDS];
+    int          map[PK_KINDS];   // index into maps, -1 = not file backed
+    int64_t      n_expert;
+    uint64_t   * count;           // [n_expert] routing counts
+    uint32_t   * trans;           // [n_expert * n_expert_next] transitions to layer + 1
+    int64_t      n_expert_next;
+    int          sel[PK_MAX_USED];
+    int          n_sel;
+    int          pred[PK_MAX_USED];
+    int          n_pred;
+    uint8_t    * pinned;          // [n_expert]
+    // v2 expert cache
+    struct pk_entry * ent;        // [n_expert]
+    size_t       koff[PK_KINDS];  // offset of each projection inside an entry
+    size_t       slab;            // bytes of one expert (all projections)
+    int          layout;          // 1 once every projection of the layer is known
+    // router of this layer (for lookahead from layer - 1)
+    const char * router;
+    int          router_type;
+    int64_t      router_ne0, router_ne1;
+    size_t       router_nb1;
+};
+
+// one cached expert (gate/up/down slabs back to back)
+struct pk_entry {
+    char *   buf;
+    volatile int state;           // 0 empty, 1 fetching, 2 ready
+    int      transient;           // not admitted to the cache: freed after its layer step
+    int      pending;             // outstanding reads
+    volatile int ready;           // bit k set once projection k has arrived
+    uint64_t step;                // last layer step that needs it (protects from eviction)
+};
+
+static struct {
+    int    init;
+    int    enabled, predict, verbose, no_readaround, io_threads, prevtok;
+    size_t pin_bytes, warm_bytes;
+    int    pin_trunk, lazy_load;
+    size_t trunk_bytes, trunk_locked;
+    char   stats_path[1024];
+
+    pk_mutex        lock;
+    struct pk_map   maps[PK_MAX_MAPS];
+    int             n_maps;
+    struct pk_layer layers[PK_MAX_LAYERS];
+    int             max_layer;
+
+    int      cur_layer;
+    uint64_t tokens;            // decode tokens observed
+    // v2
+    size_t   cache_budget, cache_used;
+    int      lookahead, fetch_threads;
+    uint64_t step;
+    const struct ggml_tensor * cur_w;
+    int      cur_l, cur_k, cur_decode;
+    uint64_t cache_hits, cache_misses, fetched_bytes, la_hits, la_total, transient_bytes;
+    uint64_t advise_calls, advise_bytes;
+    uint64_t pred_hits, pred_total;
+    size_t   pinned_bytes;
+    int      stats_loaded;
+} pk = { .lock = PK_MUTEX_INIT, .cur_layer = -1 };
+
+static void pk_save_stats(void);
+
+static void pk_init(void) {
+    if (pk.init) {
+        return;
+    }
+    pk.init = 1;
+    const char * e = getenv("POCKET_MOE");
+    pk.enabled = e && atoi(e) != 0;
+    e = getenv("POCKET_MOE_NORA");
+    pk.no_readaround = e ? atoi(e) : 0;
+    e = getenv("POCKET_MOE_PREDICT");
+    pk.predict = e ? atoi(e) != 0 : 0;  // off by default: wrong guesses cost bandwidth (measured)
+    e = getenv("POCKET_MOE_VERBOSE");
+    pk.verbose = e && atoi(e) != 0;
+    e = getenv("POCKET_MOE_PIN_MIB");
+    pk.pin_bytes = e ? (size_t) atoll(e) << 20 : 0;
+    e = getenv("POCKET_MOE_LAZY_LOAD");
+    pk.lazy_load = e && atoi(e) != 0;
+    e = getenv("POCKET_MOE_PIN_TRUNK");
+    pk.pin_trunk = e && atoi(e) != 0;
+    e = getenv("POCKET_MOE_WARM_MIB");
+    pk.warm_bytes = e ? (size_t) atoll(e) << 20 : 0;
+    e = getenv("POCKET_MOE_PREVTOK");
+    pk.prevtok = e && atoi(e) != 0;
+    e = getenv("POCKET_MOE_IO_THREADS");
+    pk.io_threads = e ? atoi(e) : 0;
+    if (pk.io_threads > 32) pk.io_threads = 32;
+    e = getenv("POCKET_MOE_CACHE_MIB");
+    pk.cache_budget = e ? (size_t) atoll(e) << 20 : 0;
+    e = getenv("POCKET_MOE_LOOKAHEAD");
+    pk.lookahead = e ? atoi(e) != 0 : 0;  // off by default until real-model labs show a gain
+    e = getenv("POCKET_MOE_FETCH_THREADS");
+    pk.fetch_threads = e ? atoi(e) : 16;
+    if (pk.fetch_threads < 1) pk.fetch_threads = 1;
+    if (pk.fetch_threads > 64) pk.fetch_threads = 64;
+#if defined(_WIN32)
+    pk.cache_budget = 0;  // v2 cache is POSIX-only for now; Windows uses v1 prefetch
+#endif
+    e = getenv("POCKET_MOE_STATS");
+    if (e) {
+        snprintf(pk.stats_path, sizeof(pk.stats_path), "%s", e);
+    }
+    if (pk.enabled) {
+        atexit(pk_save_stats);
+    }
+}
+
+bool ggml_pocket_enabled(void) {
+    pk_init();
+    return pk.enabled;
+}
+
+void ggml_pocket_register_mapping(const void * addr, size_t size, int fd) {
+    pk_init();
+    if (!addr) {
+        return;
+    }
+    if (pk.no_readaround == 2) {
+        // whole mapping: no fault read-around anywhere (also hurts dense weights - diagnostic only)
+        pk_no_readaround(addr, size);
+    }
+    if (!pk.enabled) {
+        return;
+    }
+    pk_lock(&pk.lock);
+    if (pk.n_maps < PK_MAX_MAPS) {
+#if defined(_WIN32)
+        (void) fd;  // Windows prefetches by address range, no descriptor needed
+        pk.maps[pk.n_maps++] = (struct pk_map) { (const char *) addr, size, -1 };
+#else
+        int own = fd >= 0 ? dup(fd) : -1;  // keep our own descriptor: the loader may close its file
+#if defined(__APPLE__)
+        if (own >= 0 && pk.cache_budget) {
+            fcntl(own, F_NOCACHE, 1);  // v2 keeps experts in its own cache: do not double-cache them
+        }
+#endif
+        if (own >= 0) {
+            pk.maps[pk.n_maps++] = (struct pk_map) { (const char *) addr, size, own };
+        }
+#endif
+    }
+    pk_unlock(&pk.lock);
+}
+
+static int pk_find_map(const void * p) {
+    const char * c = (const char *) p;
+    for (int i = 0; i < pk.n_maps; i++) {
+        if (c >= pk.maps[i].base && c < pk.maps[i].base + pk.maps[i].size) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+#if !defined(_WIN32)
+// ---- optional I/O worker pool: blocking pread() into a scratch buffer fills the page cache.
+// Fallback for systems where read-ahead advice is weak (POCKET_MOE_IO_THREADS=N; POSIX only).
+#define PK_QCAP 4096
+static struct {
+    pthread_mutex_t mu;
+    pthread_cond_t  cv;
+    struct { int fd; off_t off; size_t n; } q[PK_QCAP];
+    int head, tail, started;
+} io = { .mu = PTHREAD_MUTEX_INITIALIZER, .cv = PTHREAD_COND_INITIALIZER };
+
+static void * pk_io_worker(void * arg) {
+    (void) arg;
+    size_t cap = 4u << 20;
+    char * buf = malloc(cap);
+    for (;;) {
+        pthread_mutex_lock(&io.mu);
+        while (io.head == io.tail) pthread_cond_wait(&io.cv, &io.mu);
+        int fd = io.q[io.tail].fd; off_t off = io.q[io.tail].off; size_t n = io.q[io.tail].n;
+        io.tail = (io.tail + 1) % PK_QCAP;
+        pthread_mutex_unlock(&io.mu);
+        while (n > 0) {
+            ssize_t r = pread(fd, buf, n < cap ? n : cap, off);
+            if (r <= 0) break;
+            off += r; n -= (size_t) r;
+        }
+    }
+    return NULL;
+}
+
+static int pk_io_submit(int fd, off_t off, size_t n) {
+    if (!io.started) {
+        io.started = 1;
+        for (int i = 0; i < pk.io_threads; i++) {
+            pthread_t t;
+            if (pthread_create(&t, NULL, pk_io_worker, NULL) == 0) pthread_detach(t);
+        }
+    }
+    pthread_mutex_lock(&io.mu);
+    int next = (io.head + 1) % PK_QCAP;
+    int ok = next != io.tail;   // drop the request if the queue is full: it is only a hint
+    if (ok) { io.q[io.head].fd = fd; io.q[io.head].off = off; io.q[io.head].n = n; io.head = next; }
+    pthread_cond_signal(&io.cv);
+    pthread_mutex_unlock(&io.mu);
+    return ok;
+}
+#endif
+
+// async read-ahead of [p, p + n) from the file behind mapping m
+static void pk_advise(int m, const char * p, size_t n) {
+    if (m < 0 || n == 0) {
+        return;
+    }
+    const struct pk_map * mp = &pk.maps[m];
+#if defined(_WIN32)
+    (void) mp;
+    static pk_prefetch_fn prefetch = NULL;
+    static int looked_up = 0;
+    if (!looked_up) {
+        looked_up = 1;
+        prefetch = (pk_prefetch_fn) (void *) GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "PrefetchVirtualMemory");
+        if (!prefetch && pk.verbose) {
+            fprintf(stderr, "pocket: PrefetchVirtualMemory unavailable (Windows 8+ needed), prefetch disabled\n");
+        }
+    }
+    if (!prefetch) {
+        return;
+    }
+    size_t len;
+    pk_range r;
+    r.addr = pk_align(p, n, &len);
+    r.size = len;
+    prefetch(GetCurrentProcess(), 1, &r, 0);
+#else
+    off_t off = (off_t) (p - mp->base);
+    if (pk.io_threads > 0) {
+        pk_io_submit(mp->fd, off, n);
+        pk.advise_calls++;
+        pk.advise_bytes += n;
+        return;
+    }
+#if defined(__APPLE__)
+    struct radvisory ra = { .ra_offset = off, .ra_count = (int) (n > INT32_MAX ? INT32_MAX : n) };
+    fcntl(mp->fd, F_RDADVISE, &ra);
+#elif defined(POSIX_FADV_WILLNEED)
+    posix_fadvise(mp->fd, off, (off_t) n, POSIX_FADV_WILLNEED);
+#else
+    size_t len;
+    void * b = pk_align(p, n, &len);
+    madvise(b, len, MADV_WILLNEED);
+#endif
+#endif
+    pk.advise_calls++;
+    pk.advise_bytes += n;
+}
+
+bool ggml_pocket_lazy_load(void) {
+    pk_init();
+    return pk.enabled && pk.lazy_load;
+}
+
+void ggml_pocket_trunk_hint(const char * name, const void * data, size_t size) {
+    pk_init();
+    if (!pk.enabled || !name || !data || !size || strstr(name, "_exps")) {
+        return;  // routed experts are streamed on demand
+    }
+    if (strncmp(name, "token_embd", 10) == 0) {
+        return;  // a row lookup per token, not read in full
+    }
+    pk_lock(&pk.lock);
+    int m = pk_find_map(data);
+    pk.trunk_bytes += size;
+    if (m >= 0) {
+        pk_advise(m, (const char *) data, size);
+    }
+    if (pk.pin_trunk) {
+        if (pk_lock_pages(data, size, 1) == 0) {
+            pk.trunk_locked += size;
+        } else {
+            if (pk.verbose) fprintf(stderr, "pocket: cannot lock the dense weights (memory lock limit); not pinned\n");
+            pk.pin_trunk = 0;
+        }
+    }
+    pk_unlock(&pk.lock);
+}
+
+static void pk_prefetch_expert(struct pk_layer * L, int e) {
+    for (int k = 0; k < PK_KINDS; k++) {
+        if (L->data[k] && L->map[k] >= 0) {
+            pk_advise(L->map[k], L->data[k] + (size_t) e * L->nb2[k], L->nb2[k]);
+        }
+    }
+}
+
+static size_t pk_expert_bytes(const struct pk_layer * L) {
+    size_t b = 0;
+    for (int k = 0; k < PK_KINDS; k++) {
+        if (L->data[k] && L->map[k] >= 0) {
+            b += L->nb2[k];
+        }
+    }
+    return b;
+}
+
+// returns 1 if every projection of the expert was (un)locked
+static int pk_pin(struct pk_layer * L, int e, int on) {
+    int ok = 1;
+    for (int k = 0; k < PK_KINDS; k++) {
+        if (!L->data[k] || L->map[k] < 0) {
+            continue;
+        }
+        const char * p = L->data[k] + (size_t) e * L->nb2[k];
+        if (pk_lock_pages(p, L->nb2[k], on) != 0) {
+            ok = 0;
+        }
+    }
+    if (!ok && on) {
+        // undo the partial lock so the expert is streamed like any other
+        pk_pin(L, e, 0);
+    }
+    return ok;
+}
+
+// pin the globally most-routed experts up to the byte budget (greedy by count)
+static void pk_update_pins(void) {
+    if (!pk.pin_bytes) {
+        return;
+    }
+    // collect candidates
+    size_t n_cand = 0;
+    for (int l = 0; l <= pk.max_layer; l++) {
+        n_cand += pk.layers[l].count ? (size_t) pk.layers[l].n_expert : 0;
+    }
+    if (!n_cand) {
+        return;
+    }
+    struct cand { uint64_t c; int l, e; } * cs = malloc(n_cand * sizeof(*cs));
+    size_t n = 0;
+    for (int l = 0; l <= pk.max_layer; l++) {
+        struct pk_layer * L = &pk.layers[l];
+        if (!L->count || !pk_expert_bytes(L)) {
+            continue;
+        }
+        for (int e = 0; e < L->n_expert; e++) {
+            if (L->count[e]) {
+                cs[n++] = (struct cand) { L->count[e], l, e };
+            }
+        }
+    }
+    // partial selection sort is fine: n is at most a few tens of thousands
+    size_t budget = pk.pin_bytes, used = 0;
+    uint8_t * want_any = calloc(n ? n : 1, 1);
+    for (size_t i = 0; i < n; i++) {
+        size_t best = i;
+        for (size_t j = i + 1; j < n; j++) {
+            if (cs[j].c > cs[best].c) {
+                best = j;
+            }
+        }
+        struct cand t = cs[i]; cs[i] = cs[best]; cs[best] = t;
+        size_t eb = pk_expert_bytes(&pk.layers[cs[i].l]);
+        if (used + eb > budget) {
+            break;
+        }
+        used += eb;
+        want_any[i] = 1;
+    }
+    // apply: unpin what is no longer wanted, pin new ones
+    for (int l = 0; l <= pk.max_layer; l++) {
+        struct pk_layer * L = &pk.layers[l];
+        if (!L->pinned) {
+            continue;
+        }
+        for (int e = 0; e < L->n_expert; e++) {
+            int want = 0;
+            for (size_t i = 0; i < n && want_any[i]; i++) {
+                if (cs[i].l == l && cs[i].e == e) { want = 1; break; }
+            }
+            if (want && !L->pinned[e] && pk.pin_bytes) {
+                if (pk_pin(L, e, 1)) {
+                    L->pinned[e] = 1;
+                } else {
+                    // memory-lock limit (ulimit -l / working-set quota): stop pinning, keep streaming
+                    fprintf(stderr, "pocket: memory lock limit reached; hot-expert pinning disabled\n");
+                    pk.pin_bytes = 0;
+                }
+            } else if (!want && L->pinned[e]) {
+                pk_pin(L, e, 0);
+                L->pinned[e] = 0;
+            }
+        }
+    }
+    (void) used;
+    pk.pinned_bytes = 0;
+    for (int l = 0; l <= pk.max_layer; l++) {   // report what is actually locked
+        struct pk_layer * L = &pk.layers[l];
+        for (int e = 0; L->pinned && e < L->n_expert; e++) {
+            if (L->pinned[e]) pk.pinned_bytes += pk_expert_bytes(L);
+        }
+    }
+    free(want_any);
+    free(cs);
+}
+
+// =====================================================================================
+// v2: PocketLLM's own expert cache (POCKET_MOE_CACHE_MIB=N, POSIX)
+//
+// Instead of hinting the kernel and letting compute threads page-fault, the engine reads
+// the routed experts itself - in parallel, in whole slabs, from every drive at once - into
+// an LFU cache with touch-count admission (an expert only displaces a colder one), and the
+// MoE kernel reads the cached copy (ggml_pocket_expert_ptr). The next layer's experts are
+// predicted by running that layer's router on the current input and fetched in the
+// background (POCKET_MOE_LOOKAHEAD, default off: slower in every lab so far). Ideas from Pulsar (MIT) and SwiftLM (MIT);
+// implementation is our own, on top of llama.cpp's CPU kernels.
+// =====================================================================================
+#if !defined(_WIN32)
+
+#define PK_JOBS 8192
+static struct {
+    pthread_mutex_t mu;
+    pthread_cond_t  cv_job, cv_done;
+    struct { int fd; off_t off; size_t n; char * dst; struct pk_entry * e; int kind; } q[PK_JOBS];
+    int head, tail, started;
+} fp = { .mu = PTHREAD_MUTEX_INITIALIZER, .cv_job = PTHREAD_COND_INITIALIZER, .cv_done = PTHREAD_COND_INITIALIZER };
+
+static void * pk_fetch_worker(void * arg) {
+    (void) arg;
+    for (;;) {
+        pthread_mutex_lock(&fp.mu);
+        while (fp.head == fp.tail) pthread_cond_wait(&fp.cv_job, &fp.mu);
+        int fd = fp.q[fp.tail].fd; off_t off = fp.q[fp.tail].off; size_t n = fp.q[fp.tail].n;
+        char * dst = fp.q[fp.tail].dst; struct pk_entry * e = fp.q[fp.tail].e; int kind = fp.q[fp.tail].kind;
+        fp.tail = (fp.tail + 1) % PK_JOBS;
+        pthread_mutex_unlock(&fp.mu);
+
+        size_t done = 0;
+        while (done < n) {
+            ssize_t r = pread(fd, dst + done, n - done, off + (off_t) done);
+            if (r <= 0) break;
+            done += (size_t) r;
+        }
+#if defined(POSIX_FADV_DONTNEED)
+        posix_fadvise(fd, off, (off_t) n, POSIX_FADV_DONTNEED);  // the copy lives in our cache now
+#endif
+        pthread_mutex_lock(&fp.mu);
+        if (done < n) {
+            memset(dst + done, 0, n - done);  // never expected; keep the buffer defined
+        }
+        e->ready |= 1 << kind;        // compute threads may start on this projection now
+        if (--e->pending == 0) {
+            e->state = 2;
+        }
+        pthread_cond_broadcast(&fp.cv_done);
+        pthread_mutex_unlock(&fp.mu);
+    }
+    return NULL;
+}
+
+static void pk_fetch_start(void) {
+    if (fp.started) return;
+    fp.started = 1;
+    for (int i = 0; i < pk.fetch_threads; i++) {
+        pthread_t t;
+        if (pthread_create(&t, NULL, pk_fetch_worker, NULL) == 0) pthread_detach(t);
+    }
+}
+
+static int pk_layout_ready(struct pk_layer * L) {
+    if (L->layout) return 1;
+    // the layer is known once its gate (or gate_up) and down projections have been seen
+    int have_gate = L->data[0] || L->data[3];
+    if (!have_gate || !L->data[2] || (L->data[0] && !L->data[1])) return 0;
+    size_t off = 0;
+    for (int k = 0; k < PK_KINDS; k++) {
+        if (L->data[k] && L->map[k] < 0) return 0;  // not file backed: nothing to stream
+        L->koff[k] = off;
+        if (L->data[k]) off += (L->nb2[k] + 63) & ~(size_t) 63;
+    }
+    L->slab = off;
+    L->ent = calloc((size_t) L->n_expert, sizeof(struct pk_entry));
+    L->layout = L->ent != NULL;
+    return L->layout;
+}
+
+// pick the coldest admitted entry that the current/next step does not need
+static int pk_victim(uint64_t min_count, int * vl, int * ve) {
+    uint64_t best = UINT64_MAX;
+    *vl = -1;
+    for (int l = 0; l <= pk.max_layer; l++) {
+        struct pk_layer * L = &pk.layers[l];
+        if (!L->ent) continue;
+        for (int e = 0; e < L->n_expert; e++) {
+            struct pk_entry * en = &L->ent[e];
+            if (en->state != 2 || en->transient || en->step >= pk.step) continue;
+            if (L->count[e] < best) { best = L->count[e]; *vl = l; *ve = e; }
+        }
+    }
+    return *vl >= 0 && best < min_count;
+}
+
+// make sure expert e of layer l is resident or on its way; `need_step` protects it until then
+static void pk_ensure(int l, int e, uint64_t need_step) {
+    struct pk_layer * L = &pk.layers[l];
+    struct pk_entry * en = &L->ent[e];
+    if (en->step < need_step) en->step = need_step;
+    if (en->state != 0) {
+        pk.cache_hits += en->state == 2;
+        return;
+    }
+    pk.cache_misses++;
+    int transient = 1;
+    if (pk.cache_used + L->slab <= pk.cache_budget) {
+        transient = 0;
+    } else {
+        int vl, ve;
+        if (pk_victim(L->count[e] + 1, &vl, &ve)) {   // touch-count admission
+            struct pk_entry * v = &pk.layers[vl].ent[ve];
+            free(v->buf);
+            v->buf = NULL;
+            v->state = 0;
+            pk.cache_used -= pk.layers[vl].slab;
+            transient = 0;
+        }
+    }
+    char * buf = NULL;
+    if (posix_memalign((void **) &buf, 4096, L->slab) != 0) return;  // stay on the mmap path
+    en->buf = buf;
+    en->transient = transient;
+    if (transient) pk.transient_bytes += L->slab; else pk.cache_used += L->slab;
+    pthread_mutex_lock(&fp.mu);
+    en->state = 1;
+    en->pending = 0;
+    en->ready = 0;
+    for (int k = 0; k < PK_KINDS; k++) {
+        if (!L->data[k]) continue;
+        const struct pk_map * mp = &pk.maps[L->map[k]];
+        const char * src = L->data[k] + (size_t) e * L->nb2[k];
+        int next = (fp.head + 1) % PK_JOBS;
+        if (next == fp.tail) {  // queue full: read it ourselves
+            pthread_mutex_unlock(&fp.mu);
+            ssize_t r = pread(mp->fd, buf + L->koff[k], L->nb2[k], (off_t) (src - mp->base));
+            (void) r;
+            pthread_mutex_lock(&fp.mu);
+            en->ready |= 1 << k;
+            continue;
+        }
+        fp.q[fp.head].fd = mp->fd; fp.q[fp.head].off = (off_t) (src - mp->base); fp.q[fp.head].n = L->nb2[k];
+        fp.q[fp.head].dst = buf + L->koff[k]; fp.q[fp.head].e = en; fp.q[fp.head].kind = k;
+        fp.head = next;
+        en->pending++;
+        pk.fetched_bytes += L->nb2[k];
+    }
+    if (en->pending == 0) en->state = 2;
+    pthread_cond_broadcast(&fp.cv_job);
+    pthread_mutex_unlock(&fp.mu);
+}
+
+static void pk_wait(int l, const int * sel, int n) {
+    struct pk_layer * L = &pk.layers[l];
+    pthread_mutex_lock(&fp.mu);
+    for (int i = 0; i < n; i++) {
+        while (L->ent[sel[i]].state == 1) pthread_cond_wait(&fp.cv_done, &fp.mu);
+    }
+    pthread_mutex_unlock(&fp.mu);
+}
+
+// drop transient copies no step still needs
+static void pk_free_transients(void) {
+    for (int l = 0; l <= pk.max_layer; l++) {
+        struct pk_layer * L = &pk.layers[l];
+        if (!L->ent) continue;
+        for (int e = 0; e < L->n_expert; e++) {
+            struct pk_entry * en = &L->ent[e];
+            if (en->transient && en->state == 2 && en->step < pk.step) {
+                free(en->buf);
+                en->buf = NULL;
+                en->state = 0;
+                en->transient = 0;
+                pk.transient_bytes -= L->slab;
+            }
+        }
+    }
+}
+
+static float pk_f16(uint16_t h) {
+    uint32_t s = (uint32_t) (h & 0x8000) << 16, ex = (h >> 10) & 0x1f, m = h & 0x3ff, f;
+    if (ex == 0) {
+        if (m == 0) { f = s; }
+        else { ex = 127 - 15 + 1; while (!(m & 0x400)) { m <<= 1; ex--; } m &= 0x3ff; f = s | (ex << 23) | (m << 13); }
+    } else if (ex == 31) { f = s | 0x7f800000 | (m << 13); }
+    else { f = s | ((ex + 127 - 15) << 23) | (m << 13); }
+    float out;
+    memcpy(&out, &f, sizeof out);
+    return out;
+}
+
+// run layer l+1's router on layer l's input and fetch the experts it is likely to pick
+static void pk_lookahead(int l, const struct ggml_tensor * x, int k) {
+    if (l + 1 >= PK_MAX_LAYERS) return;
+    struct pk_layer * N = &pk.layers[l + 1];
+    if (!N->router || !N->layout || !x || x->type != GGML_TYPE_F32 || x->ne[0] != N->router_ne0) return;
+    int64_t ne = N->router_ne1 < N->n_expert ? N->router_ne1 : N->n_expert;
+    const float * v = (const float *) x->data;
+    int best[PK_MAX_USED];
+    float bestv[PK_MAX_USED];
+    int nb = 0;
+    if (k > PK_MAX_USED) k = PK_MAX_USED;
+    for (int64_t e = 0; e < ne; e++) {
+        const char * row = N->router + (size_t) e * N->router_nb1;
+        float acc = 0.0f;
+        if (N->router_type == GGML_TYPE_F32) {
+            const float * w = (const float *) row;
+            for (int64_t j = 0; j < N->router_ne0; j++) acc += w[j] * v[j];
+        } else {
+            const uint16_t * w = (const uint16_t *) row;
+            for (int64_t j = 0; j < N->router_ne0; j++) acc += pk_f16(w[j]) * v[j];
+        }
+        if (nb < k) { best[nb] = (int) e; bestv[nb++] = acc; continue; }
+        int lo = 0;
+        for (int i = 1; i < nb; i++) if (bestv[i] < bestv[lo]) lo = i;
+        if (acc > bestv[lo]) { best[lo] = (int) e; bestv[lo] = acc; }
+    }
+    pk.layers[l].n_pred = 0;
+    for (int i = 0; i < nb; i++) {
+        pk.layers[l].pred[pk.layers[l].n_pred++] = best[i];
+        pk_ensure(l + 1, best[i], pk.step + 1);
+    }
+}
+
+#endif // !_WIN32
+
+void ggml_pocket_router_hint(const struct ggml_tensor * w) {
+    if (!w || (w->type != GGML_TYPE_F32 && w->type != GGML_TYPE_F16)) return;
+    int l;
+    char kind[32];
+    if (sscanf(w->name, "blk.%d.ffn_%31[a-z_]", &l, kind) != 2 || l < 0 || l >= PK_MAX_LAYERS) return;
+    if (strcmp(kind, "gate_inp") != 0) return;
+    struct pk_layer * L = &pk.layers[l];
+    if (L->router) return;
+    pk_lock(&pk.lock);
+    L->router = (const char *) w->data;
+    L->router_type = w->type;
+    L->router_ne0 = w->ne[0];
+    L->router_ne1 = w->ne[1];
+    L->router_nb1 = w->nb[1];
+    pk_unlock(&pk.lock);
+}
+
+const char * ggml_pocket_expert_ptr(const struct ggml_tensor * w, int64_t e) {
+    const char * def = (const char *) w->data + (size_t) e * w->nb[2];
+#if !defined(_WIN32)
+    if (!pk.cache_budget || !pk.cur_decode || w != pk.cur_w) return def;
+    struct pk_layer * L = &pk.layers[pk.cur_l];
+    if (!L->ent || e < 0 || e >= L->n_expert) return def;
+    struct pk_entry * en = &L->ent[e];
+    if (en->state == 0 || !en->buf) return def;
+    const int bit = 1 << pk.cur_k;
+    if (!(en->ready & bit)) {
+        // still in flight: wait for just this projection (the rest keeps streaming meanwhile)
+        pthread_mutex_lock(&fp.mu);
+        while (!(en->ready & bit)) pthread_cond_wait(&fp.cv_done, &fp.mu);
+        pthread_mutex_unlock(&fp.mu);
+    }
+    return en->buf + L->koff[pk.cur_k];
+#else
+    return def;
+#endif
+}
+
+static int pk_kind(const char * name, int * layer) {
+    char kind[32];
+    if (sscanf(name, "blk.%d.ffn_%31[a-z_]", layer, kind) != 2) {
+        return -1;
+    }
+    if (*layer < 0 || *layer >= PK_MAX_LAYERS) return -1;
+    if (strcmp(kind, "gate_exps") == 0)    return 0;
+    if (strcmp(kind, "up_exps") == 0)      return 1;
+    if (strcmp(kind, "down_exps") == 0)    return 2;
+    if (strcmp(kind, "gate_up_exps") == 0) return 3;
+    return -1;
+}
+
+static void pk_ensure_layer(struct pk_layer * L, int64_t n_expert) {
+    if (L->count) {
+        return;
+    }
+    L->n_expert = n_expert;
+    L->count  = calloc((size_t) n_expert, sizeof(uint64_t));
+    L->pinned = calloc((size_t) n_expert, 1);
+    for (int k = 0; k < PK_KINDS; k++) L->map[k] = -1;
+}
+
+static void pk_load_stats(void) {
+    pk.stats_loaded = 1;
+    if (!pk.stats_path[0]) return;
+    FILE * f = fopen(pk.stats_path, "r");
+    if (!f) return;
+    char tag;
+    int l, e, e2;
+    unsigned long long c;
+    int n = 0;
+    while (fscanf(f, " %c", &tag) == 1) {
+        if (tag == 'C' && fscanf(f, "%d %d %llu", &l, &e, &c) == 3) {
+            if (l >= 0 && l < PK_MAX_LAYERS && pk.layers[l].count && e >= 0 && e < pk.layers[l].n_expert) {
+                pk.layers[l].count[e] += c; n++;
+            }
+        } else if (tag == 'T' && fscanf(f, "%d %d %d %llu", &l, &e, &e2, &c) == 4) {
+            struct pk_layer * L = &pk.layers[l >= 0 && l < PK_MAX_LAYERS ? l : 0];
+            if (L->trans && e >= 0 && e < L->n_expert && e2 >= 0 && e2 < L->n_expert_next) {
+                L->trans[(size_t) e * L->n_expert_next + e2] += (uint32_t) c; n++;
+            }
+        } else {
+            int ch; while ((ch = fgetc(f)) != '\n' && ch != EOF) {}
+        }
+    }
+    fclose(f);
+    if (pk.verbose) fprintf(stderr, "pocket: loaded %d routing statistics from %s\n", n, pk.stats_path);
+}
+
+// warm start (Pulsar's .warm census): the routing counts saved by earlier runs say which
+// experts this model uses most; ask the OS to read the hottest ones now, in one burst,
+// instead of faulting them in one by one while generating
+static int pk_cand_cmp(const void * a, const void * b) {
+    uint64_t x = *(const uint64_t *) a, y = *(const uint64_t *) b;
+    return x < y ? 1 : x > y ? -1 : 0;
+}
+
+static void pk_warm(void) {
+    if (!pk.warm_bytes) return;
+    size_t n_cand = 0;
+    for (int l = 0; l <= pk.max_layer; l++) {
+        n_cand += pk.layers[l].count ? (size_t) pk.layers[l].n_expert : 0;
+    }
+    if (!n_cand) return;
+    struct { uint64_t c; int l, e; } * cs = malloc(n_cand * sizeof(*cs));
+    size_t n = 0;
+    for (int l = 0; l <= pk.max_layer; l++) {
+        struct pk_layer * L = &pk.layers[l];
+        for (int e = 0; L->count && e < L->n_expert; e++) {
+            if (L->count[e] > 1) {  // seen more than in this run's first token
+                cs[n].c = L->count[e]; cs[n].l = l; cs[n].e = e; n++;
+            }
+        }
+    }
+    qsort(cs, n, sizeof(*cs), pk_cand_cmp);
+    size_t used = 0;
+    int warmed = 0;
+    for (size_t i = 0; i < n; i++) {
+        struct pk_layer * L = &pk.layers[cs[i].l];
+        size_t eb = pk_expert_bytes(L);
+        if (used + eb > pk.warm_bytes) break;
+        if (!L->pinned[cs[i].e]) pk_prefetch_expert(L, cs[i].e);
+        used += eb;
+        warmed++;
+    }
+    free(cs);
+    if (pk.verbose) fprintf(stderr, "pocket: warm start: %d experts, %.0f MiB requested\n", warmed, used / 1048576.0);
+}
+
+static void pk_save_stats(void) {
+    if (pk.verbose) {
+        fprintf(stderr, "pocket: tokens=%llu layers=%d maps=%d advise_calls=%llu advise_gb=%.2f "
+                        "pred_hit=%.1f%% (%llu/%llu) pinned_mib=%.0f trunk_mib=%.0f trunk_locked_mib=%.0f\n",
+                (unsigned long long) pk.tokens, pk.max_layer + 1, pk.n_maps,
+                (unsigned long long) pk.advise_calls, pk.advise_bytes / 1e9,
+                pk.pred_total ? 100.0 * pk.pred_hits / pk.pred_total : 0.0,
+                (unsigned long long) pk.pred_hits, (unsigned long long) pk.pred_total,
+                pk.pinned_bytes / 1048576.0, pk.trunk_bytes / 1048576.0, pk.trunk_locked / 1048576.0);
+    }
+    if (pk.verbose && pk.cache_budget) {
+        fprintf(stderr, "pocket: v2 cache_mib=%.0f/%.0f hits=%llu misses=%llu fetched_gb=%.2f transient_mib=%.0f "
+                        "lookahead_hit=%.1f%%\n",
+                pk.cache_used / 1048576.0, pk.cache_budget / 1048576.0, (unsigned long long) pk.cache_hits,
+                (unsigned long long) pk.cache_misses, pk.fetched_bytes / 1e9, pk.transient_bytes / 1048576.0,
+                pk.pred_total ? 100.0 * pk.pred_hits / pk.pred_total : 0.0);
+    }
+    if (!pk.stats_path[0] || !pk.tokens) return;
+    FILE * f = fopen(pk.stats_path, "w");
+    if (!f) return;
+    fprintf(f, "# pocketllm routing stats: C layer expert count | T layer expert next_expert count\n");
+    for (int l = 0; l <= pk.max_layer; l++) {
+        struct pk_layer * L = &pk.layers[l];
+        if (!L->count) continue;
+        for (int e = 0; e < L->n_expert; e++) {
+            if (L->count[e]) fprintf(f, "C %d %d %llu\n", l, e, (unsigned long long) L->count[e]);
+        }
+        if (!L->trans) continue;
+        for (int e = 0; e < L->n_expert; e++) {
+            for (int e2 = 0; e2 < L->n_expert_next; e2++) {
+                uint32_t c = L->trans[(size_t) e * L->n_expert_next + e2];
+                if (c) fprintf(f, "T %d %d %d %u\n", l, e, e2, c);
+            }
+        }
+    }
+    fclose(f);
+}
+
+void ggml_pocket_moe_hook(const struct ggml_tensor * w, const int64_t * counts, int64_t n_expert, int64_t n_tokens,
+                          const struct ggml_tensor * x) {
+    (void) x;  // used by v2 lookahead (POSIX only)
+    pk_init();
+    if (!pk.enabled || !w || n_expert <= 0) {
+        return;
+    }
+    int l;
+    int kind = pk_kind(w->name, &l);
+    if (kind < 0) {
+        return;
+    }
+    pk_lock(&pk.lock);
+    struct pk_layer * L = &pk.layers[l];
+    pk_ensure_layer(L, n_expert);
+    if (!L->data[kind]) {
+        L->data[kind] = (const char *) w->data;
+        L->nb2[kind]  = w->nb[2];
+        L->map[kind]  = pk_find_map(w->data);
+        if (pk.no_readaround == 1 && L->map[kind] >= 0) {
+            // expert access is sparse: stop fault read-around from pulling in neighbouring
+            // (unused) experts, but keep normal read-ahead for the dense weights
+            pk_no_readaround(w->data, ggml_nbytes(w));
+        }
+    }
+    if (l > pk.max_layer) pk.max_layer = l;
+
+    // the kernel asks ggml_pocket_expert_ptr() for this op's experts after the barrier
+    pk.cur_w = w;
+    pk.cur_l = l;
+    pk.cur_k = kind;
+    pk.cur_decode = n_tokens == 1;
+
+    if (l == pk.cur_layer) {          // second/third projection of the same layer: already handled
+        pk_unlock(&pk.lock);
+        return;
+    }
+    const int decode = n_tokens == 1;
+#if !defined(_WIN32)
+    const int use_v2 = pk.cache_budget && decode && pk.tokens >= 1 && pk_layout_ready(L);
+#else
+    const int use_v2 = 0;
+#endif
+    if (decode && l <= pk.cur_layer) {  // layers restart: a new token
+        pk.tokens++;
+        if (pk.tokens == 2 && !pk.stats_loaded) {
+            // all layers are registered after the first token: size transition tables, load stats
+            for (int i = 0; i < pk.max_layer; i++) {
+                struct pk_layer * A = &pk.layers[i], * B = &pk.layers[i + 1];
+                if (A->count && B->count && !A->trans) {
+                    A->n_expert_next = B->n_expert;
+                    A->trans = calloc((size_t) A->n_expert * B->n_expert, sizeof(uint32_t));
+                }
+            }
+            pk_load_stats();
+            pk_warm();
+            pk_update_pins();
+        } else if (pk.tokens % PK_PIN_EVERY == 0) {
+            pk_update_pins();
+        }
+    }
+    pk.cur_layer = l;
+
+    // 1. read the selected experts of this layer (all projections) ahead of the compute threads
+    int n_sel = 0;
+    int sel[PK_MAX_USED];
+#if !defined(_WIN32)
+    if (use_v2) {
+        pk.step++;
+        pk_fetch_start();
+        pk_free_transients();
+    }
+#endif
+    for (int64_t e = 0; e < n_expert; e++) {
+        if (counts[e] > 0) {
+            L->count[e]++;
+#if !defined(_WIN32)
+            if (use_v2) {
+                pk_ensure(l, (int) e, pk.step);
+            } else
+#endif
+            if (!L->pinned[e]) {
+                pk_prefetch_expert(L, (int) e);
+            }
+            if (n_sel < PK_MAX_USED) sel[n_sel++] = (int) e;
+        }
+    }
+
+    if (decode && n_sel <= PK_MAX_USED) {
+        // score the previous layer's prediction and learn the transition
+        if (l > 0) {
+            struct pk_layer * P = &pk.layers[l - 1];
+            if (P->n_pred) {
+                for (int i = 0; i < n_sel; i++) {
+                    for (int j = 0; j < P->n_pred; j++) {
+                        if (P->pred[j] == sel[i]) { pk.pred_hits++; break; }
+                    }
+                }
+                pk.pred_total += n_sel;
+                P->n_pred = 0;
+            }
+            if (P->trans && P->n_sel) {
+                for (int a = 0; a < P->n_sel; a++) {
+                    for (int b = 0; b < n_sel; b++) {
+                        P->trans[(size_t) P->sel[a] * P->n_expert_next + sel[b]]++;
+                    }
+                }
+            }
+        }
+        // 2a. temporal locality (SwiftLM's speculative pread): the next layer tends to reuse the
+        // experts it picked for the previous token, so start reading those now
+        if (pk.prevtok && !use_v2 && l + 1 < PK_MAX_LAYERS) {
+            struct pk_layer * N2 = &pk.layers[l + 1];
+            for (int i = 0; i < N2->n_sel; i++) {
+                if (N2->count && !N2->pinned[N2->sel[i]]) pk_prefetch_expert(N2, N2->sel[i]);
+            }
+        }
+        memcpy(L->sel, sel, n_sel * sizeof(int));
+        L->n_sel = n_sel;
+
+        // 2. predict the next layer's experts from the transition counts and read them ahead
+        struct pk_layer * N = l + 1 < PK_MAX_LAYERS ? &pk.layers[l + 1] : NULL;
+        if (pk.predict && !(use_v2 && pk.lookahead) && L->trans && N && N->count) {
+            int64_t nn = L->n_expert_next;
+            uint64_t * score = calloc((size_t) nn, sizeof(uint64_t));
+            uint64_t total = 0;
+            for (int a = 0; a < n_sel; a++) {
+                const uint32_t * row = L->trans + (size_t) sel[a] * nn;
+                for (int64_t b = 0; b < nn; b++) { score[b] += row[b]; total += row[b]; }
+            }
+            L->n_pred = 0;
+            if (total) {
+                for (int k = 0; k < n_sel && k < PK_MAX_USED; k++) {
+                    int64_t best = -1;
+                    for (int64_t b = 0; b < nn; b++) {
+                        if (score[b] && (best < 0 || score[b] > score[best])) best = b;
+                    }
+                    if (best < 0) break;
+                    score[best] = 0;
+                    L->pred[L->n_pred++] = (int) best;
+                    if (!N->pinned[best]) pk_prefetch_expert(N, (int) best);
+                }
+            }
+            free(score);
+        }
+    }
+#if !defined(_WIN32)
+    if (use_v2) {
+        // queue the next layer's likely experts behind this layer's reads, then wait for ours
+        if (pk.lookahead) {
+            pk_lookahead(l, x, n_sel);
+        }
+        (void) pk_wait;  // the kernel waits per projection in ggml_pocket_expert_ptr instead
+    }
+#endif
+    pk_unlock(&pk.lock);
+}
